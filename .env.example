# RoamWise Developer API - Environment Variables

# Security
SECRET_KEY=your-super-secret-key-min-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=sqlite:///./roamwise_api.db
# For PostgreSQL: DATABASE_URL=postgresql://user:pass@localhost/roamwise_api

# Redis (for rate limiting)
REDIS_URL=redis://localhost:6379/0

# Stripe (for billing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# AI itinerary generation (optional). Without this, /v1/itinerary/generate
# returns an honest structural fallback instead of failing or faking content.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# API Pricing Tiers
TIER_BASIC_PRICE_ID=price_...
TIER_PRO_PRICE_ID=price_...
TIER_ENTERPRISE_PRICE_ID=price_...

# Application
APP_NAME=RoamWise Developer API
DEBUG=False
